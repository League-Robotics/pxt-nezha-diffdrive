{
    "name": "nezha-diffdrive",
    "version": "1.0.10",
    "description": "Closed-loop differential drive for the Nezha brick: encoder-servoed wheel speeds, twist and distance moves, curved go-to, and pose from odometry. The wheel controller runs in its own fiber.",
    "license": "MIT",
    "dependencies": {
        "core": "*",
        "microphone": "*"
    },
    "files": [
        "README.md",
        "src/diffdrive.h",
        "src/diffdrive.cpp",
        "src/motion_engine.h",
        "src/motion_engine.cpp",
        "src/platform_ports.h",
        "src/heading_wrap.h",
        "src/encoder_glitch_armor.h",
        "src/encoder_pose_source.h",
        "src/nezha_port.h",
        "src/nezha_port.cpp",
        "src/otos_port.h",
        "src/otos_port.cpp",
        "src/serial_transport.h",
        "src/serial_transport.cpp",
        "src/radio_transport.h",
        "src/radio_transport.cpp",
        "src/protocol.h",
        "src/protocol.cpp",
        "src/wire_handler.h",
        "src/wire_handler.cpp",
        "src/wire_adapter.h",
        "src/wire_adapter.cpp",
        "src/shims.cpp",
        "src/sim.ts",
        "src/run.ts",
        "src/pose.ts",
        "src/main.ts"
    ],
    "testFiles": [
        "test/test.ts",
        "test/testrig.ts"
    ],
    "supportedTargets": [
        "microbit"
    ],
    "preferredEditor": "tsprj",
    "yotta": {
        "config": {
            "microbit_radio_max_packet_size": 250
        }
    },
    "disablesVariants": [
        "mbdal"
    ]
}
